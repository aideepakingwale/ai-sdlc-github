# ============================================================
# AI-SDLC Platform — environment configuration
# Copy to .env for docker-compose; every variable is validated
# by packages/shared/src/env.ts at service boot.
# Defaults below work out-of-the-box locally with ZERO external
# API keys (mock LLM provider + mock tool connectors).
# ============================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (orchestration state, artifacts, users) ---
POSTGRES_USER=sdlc
POSTGRES_PASSWORD=sdlc_local_pw
POSTGRES_DB=sdlc
DATABASE_URL=postgresql://sdlc:sdlc_local_pw@postgres:5432/sdlc

# --- Redis (session cache, tool cache, rate limits, circuit breaker) ---
REDIS_URL=redis://redis:6379

# --- DynamoDB (phase/gate state, build recovery tracker) ---
DYNAMO_ENDPOINT=http://dynamodb:8000
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- S3 audit log (LocalStack locally; real S3 in cloud) ---
S3_ENDPOINT=http://localstack:4566
AUDIT_BUCKET=sdlc-audit-logs

# --- Content-store tier for stage artifacts ---
# filesystem = folder tree on a mounted volume (local); s3 = S3/MinIO (prod).
CONTENT_STORE_MODE=filesystem
CONTENT_STORE_PATH=/data/content-store
CONTENT_BUCKET=sdlc-content-store

# --- Auth ---
# keycloak: OIDC against the Keycloak container (default in compose)
# local:    scrypt password hashes in Postgres (offline dev / unit tests)
AUTH_MODE=keycloak
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=sdlc
KEYCLOAK_CLIENT_ID=sdlc-orchestrator
KEYCLOAK_CLIENT_SECRET=sdlc-dev-client-secret-change-in-prod
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_pw
APP_PUBLIC_URL=http://localhost:3000
# Session cookie signing secret: openssl rand -hex 32 (or scripts/gen-secret.sh)
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
SESSION_TTL_HOURS=24

# --- Service mesh (internal URLs on the compose network) ---
ORCHESTRATOR_PORT=8080
AI_CLIENT_PORT=8081
TOOLS_PORT=8082
AI_CLIENT_URL=http://ai-client:8081
TOOLS_MCP_URL=http://tool-connector:8082/mcp

# --- Generation mode: the master mock/real switch ---
# mock = always the deterministic offline generator (demos, tests)
# llm  = real models ONLY; boot fails if no provider is configured, and the
#        mock is never a silent fallback
# auto = real when any provider below is configured, else mock (default)
# Multimodel: whichever providers have credentials are used, routed by task
# tier/intent (Bedrock -> Groq -> Gemini -> Grok -> local).
GENERATION_MODE=auto

# Attachment image understanding. Uploaded images become context via a
# vision LLM (routed multi-model through ai-client: Bedrock Claude -> Gemini)
# and/or deterministic OCR (pytesseract, offline fallback).
#   auto = prefer the vision LLM, fall back to OCR when none is available (default)
#   llm  = vision LLM only (still falls back to OCR if the call fails)
#   ocr  = deterministic OCR only, never call the LLM
ATTACHMENT_VISION=auto
ATTACHMENT_VISION_MAX_EDGE=1536

# --- LLM providers (all optional; mock provider used when absent) ---
# Cloud: AWS Bedrock is the AI service platform — set BEDROCK_MODEL_ID
# and it LEADS every frontier chain (auth via task role/IRSA, no API key).
# Bedrock Claude IDs carry the `anthropic.` prefix. Leave empty locally.
BEDROCK_MODEL_ID=
BEDROCK_REGION=
# Key-based chain (fallback tier when Bedrock set): Groq -> Gemini -> Grok.
# Set LLM_FORCE_MOCK=true to force the deterministic mock even with keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# gemini-2.5-flash-lite is multimodal (vision) and still has a free tier;
# gemini-2.0-flash's free tier was retired (input-token quota now 0).
GEMINI_MODEL=gemini-2.5-flash-lite
XAI_API_KEY=
XAI_MODEL=grok-2-latest
# Local lightweight model for light/`local`-tier tasks — Ollama/vLLM
# OpenAI-compatible endpoint. Empty = the local tier falls back to the mock.
# Start the bundled Ollama with:  docker compose --profile local-llm up -d
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:3b-instruct
LLM_FORCE_MOCK=false

# --- AI observability ---
# Built-in: every LLM/tool span lands in Postgres (llm_traces), served by the
# admin 📈 Observability dashboard and the Prometheus endpoint GET /metrics.
# Optional deep tracing: set these to stream full LangGraph run trees to
# LangSmith (https://smith.langchain.com) — no code changes needed.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=ai-sdlc-platform

# --- Pipeline tuning ---
# Compress the context window past this many tokens. Kept modest so the phase
# prompt (context + instructions + completion) fits a free-tier provider's
# per-request ceiling (e.g. Groq's 12k TPM) and real generation succeeds
# instead of 413-ing into the mock fallback. Raise it on a paid/Bedrock key.
CONTEXT_TOKEN_THRESHOLD=4000
BUILD_LOOP_MAX_ITERATIONS=5
BUILD_POLL_INTERVAL_MS=30000
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# --- Enterprise tool connectors (optional; mock mode when absent) ---
# TOOLS_MODE: auto = live when creds present else mock | mock | live
TOOLS_MODE=auto
TOOL_CACHE_TTL_SECONDS=86400
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SDLC
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=SDLC
GITHUB_TOKEN=
GITHUB_REPO=

# --- External MCP servers: official GitHub + Atlassian MCP servers ---
# Leverage the maintained MCP servers alongside the in-house tool-connector.
# Enable per server and paste tokens here (never commit real tokens).
# GitHub — github/github-mcp-server (hosted remote by default; needs a PAT).
GITHUB_MCP_ENABLED=false
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=
# Atlassian — sooperset/mcp-atlassian (Jira + Confluence), run as a compose
# service with --transport streamable-http; it reuses the JIRA_*/CONFLUENCE_*
# creds above. Start it with:  docker compose --profile mcp up -d mcp-atlassian
ATLASSIAN_MCP_ENABLED=false
ATLASSIAN_MCP_URL=http://mcp-atlassian:9000/mcp
