FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY services/ai-client-service/package.json services/ai-client-service/package.json
RUN pnpm install --frozen-lockfile --filter @sdlc/shared --filter @sdlc/ai-client-service
COPY packages/shared packages/shared
COPY services/ai-client-service services/ai-client-service
RUN pnpm --filter @sdlc/shared build && pnpm --filter @sdlc/ai-client-service build \
  && pnpm --filter @sdlc/ai-client-service deploy --prod /out \
  && cp -r services/ai-client-service/dist /out/dist

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
RUN groupadd -g 10001 sdlc && useradd -u 10001 -g sdlc -m sdlc
WORKDIR /app
COPY --from=build /out /app
USER sdlc
EXPOSE 8081
CMD ["node", "dist/index.js"]
