{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sdlc/frontend", "dev"],
      "port": 5173
    },
    {
      "name": "orchestrator",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--reload"
      ],
      "port": 8080
    },
    {
      "name": "ai-client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sdlc/ai-client-service", "dev"],
      "port": 8081
    },
    {
      "name": "tool-connector",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sdlc/tool-connector-service", "dev"],
      "port": 8082
    }
  ]
}
